**.xdc file**
`timescale 1ns / 1ps

module tb_nexora_accident_system;

    reg CLK100MHZ;

    reg CPU_RESETN;

    reg [5:0] SW;

    reg SHOCK_IN;

    wire UART_TX;

    wire [7:0] LED;


    // ------------------------------------------------------------
    // Simulation parameters
    //
    // Actual board:
    //   100 MHz clock
    //   115200 baud
    //
    // Simulation:
    //   100 kHz clock
    //   10000 baud
    //
    // This makes simulation much faster.
    // ------------------------------------------------------------

    localparam integer SIM_CLK_FREQ = 100_000;

    localparam integer SIM_BAUD = 10_000;


    nexora_accident_system #(

        .CLK_FREQ_HZ(SIM_CLK_FREQ),

        .BAUD_RATE(SIM_BAUD)

    )

    DUT (

        .CLK100MHZ(CLK100MHZ),

        .CPU_RESETN(CPU_RESETN),

        .SW(SW),

        .SHOCK_IN(SHOCK_IN),

        .UART_TX(UART_TX),

        .LED(LED)

    );


    // ------------------------------------------------------------
    // 100 kHz clock
    // Period = 10 us
    // ------------------------------------------------------------

    initial begin

        CLK100MHZ = 1'b0;

        forever #5000 CLK100MHZ = ~CLK100MHZ;

    end


    // ------------------------------------------------------------
    // TEST SEQUENCE
    // ------------------------------------------------------------

    initial begin

        CPU_RESETN = 1'b0;

        SW = 6'b000000;

        SHOCK_IN = 1'b0;


        // Reset

        #100_000;

        CPU_RESETN = 1'b1;


        // --------------------------------------------------------
        // TEST 1 : SAFE
        // --------------------------------------------------------

        #100_000;

        $display("TEST 1: SAFE");

        $display("LED = %b",LED);


        // --------------------------------------------------------
        // TEST 2 : WARNING
        //
        // SW3 = high speed
        // --------------------------------------------------------

        SW[3] = 1'b1;

        #100_000;

        $display("TEST 2: WARNING");

        $display("LED = %b",LED);

        SW[3] = 1'b0;


        // --------------------------------------------------------
        // TEST 3 : CRITICAL
        //
        // High speed + very short distance
        // --------------------------------------------------------

        SW[3] = 1'b1;

        SW[5] = 1'b1;

        #100_000;

        $display("TEST 3: CRITICAL");

        $display("LED = %b",LED);

        SW[3] = 1'b0;

        SW[5] = 1'b0;


        // --------------------------------------------------------
        // TEST 4 : ACCIDENT
        //
        // SW1 = acceleration change
        // SW2 = speed drop
        //
        // Shock HIGH for 250 ms
        //
        // 250/250 = 100%
        // 100% >= 70%
        // --------------------------------------------------------

        SW[1] = 1'b1;

        SW[2] = 1'b1;

        SHOCK_IN = 1'b1;


        // 250 ms

        #250_000_000;


        #100_000;


        if (DUT.impact_valid &&
            DUT.accident_detected)

            $display("PASS: ACCIDENT DETECTED");

        else

            $display("FAIL: ACCIDENT NOT DETECTED");


        // Clear inputs

        SHOCK_IN = 1'b0;

        SW[1] = 1'b0;

        SW[2] = 1'b0;


        // --------------------------------------------------------
        // Wait for UART heartbeat
        // --------------------------------------------------------

        #1_100_000_000;


        $display("SIMULATION COMPLETE");

        $finish;

    end


    // ------------------------------------------------------------
    // Monitor
    // ------------------------------------------------------------

    always @(posedge CLK100MHZ) begin

        if (DUT.impact_valid)

            $display(
                "[%0t] IMPACT VALID",
                $time
            );


        if (DUT.accident_detected)

            $display(
                "[%0t] ACCIDENT DETECTED",
                $time
            );


        if (DUT.packet_request)

            $display(
                "[%0t] UART HEARTBEAT",
                $time
            );

    end

endmodule
